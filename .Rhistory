library(tidyverse)
library(tmap)
library(tidygeocoder)
library(sf)
library(dplyr)
library(stringr)
numbat <- read.csv("data\numbats.csv")
numbat <- read.csv("data/numbats.csv")
View(numbat)
library(viridis)
numbat <- read.csv("data/numbats.csv") %>%
st_as_sf(coords = c("decimalLongitude", "decimalLatitude"),
crs = 7844,
remove = FALSE)
numbat_clean <- read.csv("data/numbats.csv") %>%
filter(!is.na(decimalLongitude) & !is.na(decimalLatitude))
View(numbat_clean)
numbat_clean <- read.csv("data/numbats.csv") %>%
filter(!is.na(decimalLongitude) & !is.na(decimalLatitude)) %>%
st_as_sf(coords = c("decimalLongitude", "decimalLatitude"),
crs = 7844,
remove = FALSE)
View(numbat_clean)
numbat_clean <- read.csv("data/numbats.csv") %>%
filter(!is.na(decimalLongitude) & !is.na(decimalLatitude))
View(numbat_clean)
numbat_sp <-numbat_clean %>%
st_as_sf(coords = c("decimalLongitude", "decimalLatitude"),
crs = 7844,
remove = FALSE)
View(numbat_sp)
tm_shape(numbat_sp) +
tm_polygons()
tmap_mode("view")
tm_shape(numbat_sp) +
tm_polygons()
tm_shape(numbat_sp) +
tm_dots()
numbat_df <- numbat_sp %>%
st_set_geometry(NULL)
View(numbat_clean)
View(numbat_df)
numbat_month_observations <- numbat_df %>%
count(month)
View(numbat_month_observations)
